{
  "name": "meterflow-backend",
  "version": "1.0.0",
  "description": "MeterFlow backend API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1",
    "migrate:workspaces": "node -e \"import('./src/config/database.js').then(async m => { await m.connectDatabase(); const { backfillWorkspaces } = await import('./src/utils/migrateWorkspaces.js'); const s = await backfillWorkspaces(); console.log('Migration complete:', s); process.exit(0); });\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
